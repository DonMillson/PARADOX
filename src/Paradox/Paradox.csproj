<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Paradox</AssemblyName>
    <RootNamespace>Paradox</RootNamespace>
    <Version>0.4.0</Version>
    <Description>PARADOX - an original Among Us gameplay mod.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Reactor">
      <HintPath>../../lib/Reactor.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.787" Private="false" ExcludeAssets="runtime;native" />
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2025.4.15" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
